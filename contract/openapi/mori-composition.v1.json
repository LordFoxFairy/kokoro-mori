{
  "openapi": "3.1.0",
  "info": { "title": "Mori Composition API", "version": "0.1.0", "description": "Versioned, provider-neutral deterministic edits for Studio tracks and clips." },
  "paths": {
    "/api/v1/mori/versions/{version_ref}/composition": {
      "parameters": [{ "$ref": "#/components/parameters/VersionRef" }],
      "get": {
        "operationId": "getMoriCompositionRevision",
        "security": [{ "moriSession": [] }],
        "responses": { "200": { "description": "Current composition projection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiCompositionRevision" } } } }, "404": { "$ref": "#/components/responses/ApiError" } }
      },
      "put": {
        "operationId": "applyMoriCompositionRevision",
        "security": [{ "moriSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompositionRevisionInput" } } } },
        "responses": { "200": { "description": "Composition revision applied", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiCompositionRevision" } } } }, "409": { "$ref": "#/components/responses/ApiError" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "moriSession": { "type": "apiKey", "in": "cookie", "name": "kokoro_session" } },
    "parameters": {
      "VersionRef": { "name": "version_ref", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "schemas": {
      "CompositionCommand": { "oneOf": [
        { "$ref": "#/components/schemas/MoveClip" }, { "$ref": "#/components/schemas/TrimClip" }, { "$ref": "#/components/schemas/CropClip" }, { "$ref": "#/components/schemas/InsertClip" },
        { "$ref": "#/components/schemas/SplitClip" }, { "$ref": "#/components/schemas/SetFades" }, { "$ref": "#/components/schemas/SetTrackMix" }, { "$ref": "#/components/schemas/RemoveClip" }
      ], "discriminator": { "propertyName": "type" } },
      "MoveClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "start_ms"], "properties": { "type": { "const": "move_clip" }, "track_ref": { "type": "string", "minLength": 1, "description": "Source track for the clip." }, "target_track_ref": { "type": "string", "minLength": 1, "description": "Optional destination track; omit for an in-track move." }, "clip_ref": { "type": "string", "minLength": 1 }, "start_ms": { "type": "integer", "minimum": 0 } } },
      "CropClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "start_offset_ms", "end_offset_ms"], "properties": { "type": { "const": "crop_clip" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 }, "start_offset_ms": { "type": "integer", "minimum": 0 }, "end_offset_ms": { "type": "integer", "minimum": 0 } } },
      "InsertClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "source_ref", "start_ms", "duration_ms", "offset_ms"], "properties": { "type": { "const": "insert_clip" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 }, "source_ref": { "type": "string", "minLength": 1 }, "start_ms": { "type": "integer", "minimum": 0 }, "duration_ms": { "type": "integer", "minimum": 1 }, "offset_ms": { "type": "integer", "minimum": 0 } } },
      "TrimClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "duration_ms"], "properties": { "type": { "const": "trim_clip" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 }, "duration_ms": { "type": "integer", "minimum": 1 } } },
      "SplitClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "at_ms"], "properties": { "type": { "const": "split_clip" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 }, "at_ms": { "type": "integer", "minimum": 1 } } },
      "SetFades": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref", "fade_in_ms", "fade_out_ms"], "properties": { "type": { "const": "set_fades" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 }, "fade_in_ms": { "type": "integer", "minimum": 0 }, "fade_out_ms": { "type": "integer", "minimum": 0 } } },
      "SetTrackMix": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "gain", "pan", "muted"], "properties": { "type": { "const": "set_track_mix" }, "track_ref": { "type": "string", "minLength": 1 }, "gain": { "type": "number", "minimum": 0, "maximum": 1 }, "pan": { "type": "number", "minimum": -1, "maximum": 1 }, "muted": { "type": "boolean" } } },
      "RemoveClip": { "type": "object", "additionalProperties": false, "required": ["type", "track_ref", "clip_ref"], "properties": { "type": { "const": "remove_clip" }, "track_ref": { "type": "string", "minLength": 1 }, "clip_ref": { "type": "string", "minLength": 1 } } },
      "CompositionRevisionInput": { "type": "object", "additionalProperties": false, "required": ["expected_revision", "commands"], "properties": { "expected_revision": { "type": "integer", "minimum": 0 }, "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/components/schemas/CompositionCommand" } } } },
      "CompositionClip": { "type": "object", "additionalProperties": false, "required": ["clip_ref", "source_ref", "start_ms", "duration_ms", "offset_ms"], "properties": { "clip_ref": { "type": "string", "minLength": 1 }, "source_ref": { "type": "string", "minLength": 1 }, "start_ms": { "type": "integer", "minimum": 0 }, "duration_ms": { "type": "integer", "minimum": 1 }, "offset_ms": { "type": "integer", "minimum": 0 }, "fade_in_ms": { "type": "integer", "minimum": 0 }, "fade_out_ms": { "type": "integer", "minimum": 0 } } },
      "CompositionTrack": { "type": "object", "additionalProperties": false, "required": ["track_ref", "kind", "name", "clips"], "properties": { "track_ref": { "type": "string", "minLength": 1 }, "kind": { "enum": ["vocals", "instrumental", "other"] }, "name": { "type": "string", "minLength": 1 }, "clips": { "type": "array", "items": { "$ref": "#/components/schemas/CompositionClip" } }, "gain": { "type": "number", "minimum": 0, "maximum": 1, "description": "Optional track level; omitted means 1." }, "pan": { "type": "number", "minimum": -1, "maximum": 1, "description": "Optional track pan; omitted means center (0)." }, "muted": { "type": "boolean", "description": "Optional track mute state; omitted means false." } } },
      "CompositionRevision": { "type": "object", "additionalProperties": false, "required": ["version_ref", "revision", "tracks"], "properties": { "version_ref": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "tracks": { "type": "array", "items": { "$ref": "#/components/schemas/CompositionTrack" } } } },
      "ApiCompositionRevision": { "type": "object", "additionalProperties": false, "required": ["data", "meta"], "properties": { "data": { "$ref": "#/components/schemas/CompositionRevision" }, "meta": { "$ref": "#/components/schemas/Meta" } } },
      "Meta": { "type": "object", "additionalProperties": false, "required": ["request_id"], "properties": { "request_id": { "type": "string", "minLength": 1 } } },
      "ErrorBody": { "type": "object", "required": ["error", "meta"], "properties": { "error": { "type": "object" }, "meta": { "type": "object" } } }
    },
    "responses": { "ApiError": { "description": "Mori API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorBody" } } } } }
  }
}
